<?xml version="1.0"?>
<robot name="arm">
  <link name="world"/>
  <link name="base">
    <inertial>
      <origin xyz="-1.898173e-19 -4.9474828e-19 0.006" rpy="0 0 0"/>
      <mass value="0.013392"/>
      <inertia ixx="1.165104e-06" ixy="1.9824142e-24" ixz="6.4428463e-25" iyy="1.165104e-06" iyz="6.4428463e-25" izz="2.0088e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <link name="link">
    <inertial>
      <origin xyz="0.058474669 4.0141219e-21 5.3521625e-21" rpy="0 0 0"/>
      <mass value="0.2107136"/>
      <inertia ixx="2.571264e-07" ixy="2.4580335e-23" ixz="3.2112975e-23" iyy="1.249463e-05" iyz="3.766587e-25" izz="1.249463e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision>
      <origin xyz="-0 -0 -0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 -0 0"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="link"/>
    <origin xyz="0.015 0 0.012" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78539816" upper="1.5707963" effort="10" velocity="1"/>
  </joint>
</robot>
